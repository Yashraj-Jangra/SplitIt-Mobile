{
  "expo": {
    "name": "SplitIt",
    "slug": "splitit",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "splitit",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131417",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.splitit.app",
      "buildNumber": "6",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "upi",
          "gpay",
          "phonepe",
          "paytmmp",
          "bhim",
          "credpay",
          "slice"
        ],
        "NSCameraUsageDescription": "SplitIt needs camera access to scan physical receipts and bills for automatic expense splitting.",
        "NSPhotoLibraryUsageDescription": "SplitIt needs photo library access to upload receipt images from your photo gallery.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.splitit.app",
      "versionCode": 6,
      "backgroundColor": "#131417",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#131417",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "splitit"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "SplitIt needs camera access to scan physical receipts and bills for automatic expense splitting."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SplitIt needs photo library access to upload receipt images from your photo gallery."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.178311275102-ph0shfc0dhs7cfnefre0q4bue6h0knvp"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#00C4CC"
        }
      ],
      "./plugins/withPredictiveBack",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#131417"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://split.cvweb.qzz.io",
      "router": {},
      "eas": {
        "projectId": "564133e2-dfca-4435-b76a-9fad3532cd14"
      }
    },
    "owner": "cyber-verse"
  }
}
